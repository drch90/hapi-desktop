+            expect(h.queue.size()).toBe(0);
+            expect(h.client.emitMessagesConsumed).not.toHaveBeenCalled();
+            expect(h.client.emitSteerIndeterminate).not.toHaveBeenCalled();
+            await h.steering.acknowledge(h.uuid());
