+function renderWithI18n(ui: ReactElement) {
+    return render(<I18nProvider>{ui}</I18nProvider>)
+}
+
+function makeBlock(tool: Partial<ChatToolCall>): ToolCallBlock {
+    return {
+        kind: 'tool-call',
+        id: 'tool-1',
+        localId: null,
+        createdAt: 0,
+        tool: {
+            id: 'tool-1',
+            name: 'Bash',
+            state: 'completed',
+            input: { command: 'ls' },
+            createdAt: 0,
+            startedAt: 0,
+            completedAt: 0,
+            execStartedAt: null,
