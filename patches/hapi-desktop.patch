+        for (const data of [{ type: 'reasoning', message: 'Thinking' }, { type: 'tool-call', callId: '1' }, { type: 'token_count' }, { type: 'message', message: ' ' }]) {
+            expect(hasUnreadMessageContent(agent(data))).toBe(false)
