{
  "name": "hapi-desktop",
  "version": "0.1.6",
  "description": "A Windows workbench for your HAPI sessions",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "HAPI Desktop contributors",
  "main": "out/main/index.js",
  "workspaces": [
    "vendor/hapi/shared"
  ],
  "scripts": {
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node scripts/limit-cpu.mjs node node_modules/electron-vite/bin/electron-vite.js build",
    "typecheck": "node scripts/limit-cpu.mjs node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/limit-cpu.mjs node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/limit-cpu.mjs node node_modules/@playwright/test/cli.js test",
    "package:win": "bun run build && node scripts/limit-cpu.mjs node scripts/package-win.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" *.config.ts"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.14.29",
    "@assistant-ui/react-markdown": "^0.14.7",
    "@assistant-ui/tap": "^0.9.8",
    "@elevenlabs/react": "^0.13.0",
    "@hapi/protocol": "workspace:*",
    "@lobehub/icons": "^5.14.0",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@shikijs/langs": "^3.20.0",
    "@shikijs/themes": "^3.20.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/router-core": "^1.171.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "^2.0.4",
    "i18next": "^25.8.0",
    "jsdom": "^26.1.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.0",
    "prettier": "^3.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.20.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0",
    "zod": "^4.2.1"
  },
  "build": {
    "appId": "run.hapi.desktop",
    "productName": "HAPI Desktop",
    "directories": {
      "output": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "UPSTREAM.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "HAPI-Desktop-${version}-win-${arch}-setup.${ext}"
    }
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
