  "desktopChanges": [
    "API transport injection",
    "disable message-history disk persistence",
    "open request_user_input URLs through desktop IPC",
    "notification parser protocol import",
    "ShareTurnDialog optional desktop image rendering, clipboard and save hooks",
    "Question footers support bounded scrolling with fixed navigation",
    "Export shared file sorting, rows, diff display and content helpers for the desktop sidebar",
    "DirectoryTree optional native download slot, directory context menu and account-scoped expansion storage",
    "SessionActionMenu optional reference base URL for root-relative desktop citations",
    "Backport Hermes flavor, native policies, model discovery/picker, commands, resume identity and approval semantics",
    "Export shared Markdown Table with keyboard scrolling; regenerate permission catalog for Hermes",
    "MachineSelector optional placeholder when a preselected workspace runner becomes unavailable",
    "Extend shared syntax highlighting with lazy common grammars, aliases and file-name detection",
    "Expose cached slash-command filtering and avoid scrolling unchanged autocomplete selections",
    "Desktop tool detail dialog sizing hooks and expanded subagent traces with full content",
    "Enable Claude steering capability for the companion CLI and Hub patch",
    "Bound code and diff rendering with lossless text sections, skip oversized syntax highlighting, and avoid per-character file-preview allocations",
    "Distinguish pending steer receipts from unknown delivery and preserve queued messages across reconnects",
    "Optional article presentation for tool groups with shared history loading and detail dialogs",
    "Align HAPI v0.33.5 protocol, chat pipeline, model catalogs, compaction receipts, command timing and provisional titles while retaining desktop adapters",
    "Keep request_user_input submissions locked after REST acceptance until native confirmation, with stale-request guards and localized waiting feedback",
    "Enable OpenCode steering for a live remote runtime through the existing message delivery and receipt contracts"
  ],
